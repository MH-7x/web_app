generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id             String             @id @default(cuid())
  name           String // English name
  nameAr         String // Arabic name
  slug           String             @unique // URL-safe ID ("al-afnan")
  category       String             @default("moving") // moving, used_furniture, pickup_rental
  emirate        String // Dubai, Sharjah, RAK, etc. (where the company is based)
  emiratesServed Json               @default("[]") // other emirates served, e.g. ["Ajman", "Abu Dhabi"]
  areas          Json // ["Al Nahda", "Al Majaz"]
  services       Json // ["furniture moving", "packing"]
  phone          String
  whatsapp       String
  website        String?
  brandColors    Json? // {primary, secondary}
  brandSpecs     Json? // {truckType, uniform, initialSetup}
  tone           String? // "professional, trustworthy"
  notes          String?
  facebookUrl    String             @default("")
  instagramUrl   String             @default("")
  driveLink      String             @default("") // Google Drive folder with the client's assets
  otherLinks     Json               @default("[]") // [{label, url}] e.g. TikTok, LinkedIn
  apiCredentials Json? // Google OAuth tokens per service
  clientNotes    String             @default("[]") // JSON [{id, text, pinned, createdAt}]: quick notes shown on the client page
  companyProfile String             @default("") // the company's full profile (services, selling points, fleet...), fed to the generators
  onboardingChecklist String        @default("[]") // JSON [{id, label, section, checked, checkedAt, isCustom}]: setup tasks; empty until first seeded
  placeId        String             @default("") // Google Places ID: used to fetch the business's Google reviews
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  content        GeneratedContent[]
  posts          GBPPost[]
  audits         Audit[]
  reviews        Review[]
  citations           ClientCitation[]
  citationCompetitors CitationCompetitor[]
}

model GeneratedContent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String // gbp, faq, blog, meta, fb-ad, report, humanized
  subtype   String? // emirate name, service name, etc.
  language  String // ar, en, both
  content   String // The generated text (full)
  contentAr String? // Arabic version if generated separately
  metadata  Json? // char counts, keyword, options used
  humanized Boolean  @default(false)
  score     Float? // Humanizer AI-detection score
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model PromptTemplate {
  id              String   @id @default(cuid())
  name            String   @unique // gbp-description, faq-generation, etc.
  systemPrompt    String // The full system prompt
  fewShotExamples Json? // Array of example inputs/outputs
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

model GBPPost {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  category      String // service-highlight, customer-tip, seasonal-offer, area-specific, trust-signal, behind-the-scenes
  textAr        String // Arabic is the primary version
  textEn        String
  language      String   @default("both") // en, ar, both: which versions were written (the other column is left empty)
  postType      String // whats-new, offer, event
  cta           String // call, learn-more, book
  keywords      Json? // ["Sharjah movers", ...]
  imagePrompt   String?
  status        String   @default("draft") // draft, approved, published
  publishedAt   DateTime? // when it went live on Google
  gbpPostId     String? // the Google local post name returned on publish
  scheduledFor  DateTime? // planned publish time; published by hand for now
  imageUrl      String   @default("") // public https URL of the photo to attach
  createdAt     DateTime @default(now())

  @@index([clientId, scheduledDate])
}

model Audit {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url             String
  scores          Json // {onPage, schema, speed, indexation, overall, passed/total per category, pages}
  findings        Json // [{id, category, severity, title, detail, targets: []}]
  recommendations Json // [{findingId, text}]
  log             String   @default("[]") // JSON [{timestamp, level, message}]: the full crawl log
  keywordChecks   String   @default("[]") // JSON [{url, keyword, found, inTitle, inH1, inFirst100, inUrl, inMeta, score}]
  createdAt       DateTime @default(now())

  @@index([clientId, createdAt])
}

/// A Google review of a client's business, fetched with the Places API and cached so the inbox loads without an API call.
model Review {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewId    String    @unique // the Places review resource name; unique so a re-fetch never duplicates
  authorName  String
  rating      Int
  text        String
  language    String    @default("en") // en, ar
  publishedAt DateTime
  replyStatus String    @default("none") // none, drafted, replied
  replyDraft  String    @default("")
  repliedAt   DateTime?
  fetchedAt   DateTime  @default(now())

  @@index([clientId, publishedAt])
  @@index([replyStatus, rating])
}

model GBPConnection {
  id              String   @id @default(cuid())
  clientId        String   @unique
  googleAccountId String
  locationId      String
  locationName    String   @default("")
  accessToken     String
  refreshToken    String
  tokenExpiry     DateTime
  connected       Boolean  @default(true)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KeywordGroup {
  id        String   @id @default(cuid())
  name      String
  clientId  String? // null: shared across all clients
  keywords  String   @default("[]") // JSON [{keyword, avgMonthlySearches, threeMonthChange, competition, topOfPageBidLow, topOfPageBidHigh}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Project {
  id                 String   @id @default(cuid())
  name               String
  clientName         String
  contactName        String   @default("")
  contactWhatsapp    String   @default("")
  companyDescription String   @default("")
  websiteUrl         String   @default("")
  emirate            String   @default("")
  category           String   @default("moving") // moving, used_furniture, pickup_rental, other
  pages              String   @default("[]") // JSON [{name, type, notes}]
  servicePageCount   Int      @default(0)
  locationPageCount  Int      @default(0)
  corePages          String   @default("[]") // JSON ["home", "about", "contact", "blog"]
  projectFocus       String   @default("seo") // ads, seo, combined
  secondaryServices  String   @default("[]") // JSON ["facebook", "instagram", "social_management", "gbp"]
  websiteCost        Float    @default(0)
  seoCost            Float    @default(0)
  adsCost            Float    @default(0) // no longer used: Google Ads is included in the website price
  socialCost         Float    @default(0)
  otherCosts         String   @default("[]") // JSON [{name, amount}]
  totalCost          Float    @default(0)
  seoMonths          Int      @default(0)
  adsMonths          Int      @default(0) // no longer used: Google Ads management is a yes/no (adsIncluded) with no price or duration
  adsIncluded        Boolean  @default(false) // Google Ads management is included in the website development price
  paymentTerms       String   @default("")
  deliveryWeeks      Int      @default(4)
  proposal           String   @default("") // the generated proposal, markdown
  status             String   @default("draft") // draft, sent, accepted, declined
  clientId           String? // set once the project has been converted into a client
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
}

/// Key/value app settings: business name, tagline and proposal terms.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A competitor page read for the landing page generator, cached per URL so the same page is not crawled again for 30 days.
model CompetitorPage {
  id        String   @id @default(cuid())
  url       String   @unique // normalized: no hash, no trailing slash
  data      String   @default("{}") // JSON: the page's structure and capped text, see lib/competitor-types.ts
  fetchedAt DateTime @default(now())
}

/// A directory or listing site where businesses should be listed (Yellow Pages UAE, Bing Places...). One shared list for every client.
model CitationSource {
  id              String           @id @default(cuid())
  name            String           @unique
  url             String
  submitUrl       String           @default("") // where a new listing is submitted, when known
  sourceType      String           @default("nap_citation") // nap_citation: a directory listing checked for name/address/phone/website; backlink: a profile or post that only needs a live link
  category        String           @default("general") // general, industry, uae-local, international, social, maps; backlinks: web2, profile, forum, classified
  domainAuthority Int              @default(0)
  relevantFor     String           @default("[\"all\"]") // JSON ["all"] or ["moving", "used_furniture", "pickup_rental"]
  napFields       String           @default("[]") // JSON of what the directory supports: name, address, phone, website, email, hours, description, photos
  isFree          Boolean          @default(true)
  priority        String           @default("medium") // high, medium, low
  tier            Int              @default(4) // 1 must have, 2 high-impact UAE, 3 industry specific, 4 general / international
  notes           String           @default("")
  createdAt       DateTime         @default(now())
  citations       ClientCitation[]
}

/// Where one client is listed on one directory, and whether the name, address, phone and website there are correct.
model ClientCitation {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  citationSourceId String
  source           CitationSource @relation(fields: [citationSourceId], references: [id], onDelete: Cascade)
  status           String         @default("unchecked") // unchecked, listed, not_listed, issues_found
  nameMatch        Boolean        @default(false)
  addressMatch     Boolean        @default(false)
  phoneMatch       Boolean        @default(false)
  websiteMatch     Boolean        @default(false)
  listingUrl       String         @default("")
  linkUrl          String         @default("") // backlink sources only: the page that links to the client's site
  linkStatus       String         @default("") // backlink sources only: "" (not created), pending, live, dead
  linkCreatedAt    DateTime? // backlink sources only: when a link URL was first recorded
  issues           String         @default("[]") // JSON array of strings describing what is wrong
  actionDoneAt     DateTime? // ticked off in the action plan (fixed, or submitted and waiting to appear)
  lastChecked      DateTime?
  updatedAt        DateTime       @updatedAt

  @@unique([clientId, citationSourceId])
  @@index([clientId])
}

/// A competitor and the directories it is listed on, to show which listings the client is missing. Only yes/no per directory, no NAP checks.
model CitationCompetitor {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  sourceIds String   @default("[]") // JSON of CitationSource ids the competitor is listed on
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}
