# Postgres. Supabase notes: use the POOLER strings (Project -> Connect), not the db.<ref>.supabase.co direct host: that one is
# IPv6-only and unreachable from many networks and from Vercel. Add sslmode=no-verify (Supabase's certificate authority is
# its own). URL-encode special characters in the password ($ -> %24, * -> %2A, @ -> %40).
# DATABASE_URL: what the app queries with. On Vercel use the TRANSACTION pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify"
# DIRECT_URL: used only by `pnpm db:migrate`. Use the SESSION pooler (port 5432): transaction mode breaks schema changes.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify"
# Optional: connections each server instance may hold. Default 5 in production, 10 in development.
DATABASE_POOL_MAX=
# Signs login sessions AND encrypts the Gemini key saved in Settings (random 64-character hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out and makes the saved Gemini key unreadable (enter it again in Settings).
JWT_SECRET=
GEMINI_API_KEY=
# optional, defaults to gemini-2.5-pro
GEMINI_MODEL="gemini-3.5-flash-lite"
# Chrome UX Report API key (real-user Core Web Vitals in the SEO audit)
CRUX_API_KEY=
# Optional: switch audit checks off by id (comma-separated), e.g. AUDIT_DISABLED_CHECKS=tech-dmarc,social-youtube
AUDIT_DISABLED_CHECKS=
# Optional: path to Chrome/Edge for the SEO audit if none is found automatically
PUPPETEER_EXECUTABLE_PATH=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Google OAuth client for publishing GBP posts (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET also work)
# Add <APP_URL>/api/gbp-connect/callback as an Authorized redirect URI in Google Cloud
# Optional: public origin of this app, e.g. https://dashboard.example.com (defaults to the request origin)
APP_URL=

# --- SEO audit / GBP post writing / competitor pages run on a separate worker server (Chrome needs a real machine).
# Both are needed on the DASHBOARD (Vercel) and the WORKER. Leave AUDIT_WORKER_URL empty to run everything in one process
# (local development, or one server that does it all). Full guide: docs/WORKER.md
# The worker's public address, https, no trailing slash (dashboard only):
AUDIT_WORKER_URL=
# A shared secret, 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_WORKER_SECRET=
# WORKER ONLY (the Dockerfile sets these): answer only the job routes, and use the browser installed in the image.
# WORKER_ONLY=true
# CHROME_NO_SANDBOX=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
