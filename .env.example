DATABASE_URL="file:./dev.db"
GEMINI_API_KEY=
# optional, defaults to gemini-2.5-pro
GEMINI_MODEL="gemini-3.5-flash-lite"
# Chrome UX Report API key (real-user Core Web Vitals in the SEO audit)
CRUX_API_KEY=
# Optional: switch audit checks off by id (comma-separated), e.g. AUDIT_DISABLED_CHECKS=tech-dmarc,social-youtube
AUDIT_DISABLED_CHECKS=
# Optional: path to Chrome/Edge for the SEO audit if none is found automatically
PUPPETEER_EXECUTABLE_PATH=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Google OAuth client for publishing GBP posts (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET also work)
# Add <APP_URL>/api/gbp-connect/callback as an Authorized redirect URI in Google Cloud
# Optional: public origin of this app, e.g. https://dashboard.example.com (defaults to the request origin)
APP_URL=
# Signs login sessions (random 64-character hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
